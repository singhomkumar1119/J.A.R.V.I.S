# These are server-side only (no VITE_ prefix) - set them in Vercel's
# project Environment Variables settings, NOT in a local .env that gets
# bundled into the client. They are never exposed to the browser.
GROQ_API_KEY=your_groq_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
